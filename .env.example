# Anthropic API credentials
ANTHROPIC_API_KEY=

# Filled in once by setup_agent.py — paste the printed values back here
NAMASYS_AGENT_ID=agent_01PR7uFAnp7SvJcUgMscg5GZ
NAMASYS_AGENT_VERSION=12
NAMASYS_ENVIRONMENT_ID=env_01GZ4wFkFGjfJk7PjcJ44L3V
NAMASYS_VAULT_ID=vlt_011CdjYEYA46XMAmBrjWaxpF
# Paste the printed value from setup_namasys_memory.py here (optional feature)
NAMASYS_MEMORY_STORE_ID=memstore_013a22kn81CaCWrkrY9N9exd

# Apollo.io MCP server — OAuth based, no API key needed.
# Run apollo_oauth_connect.py after setup_agent.py to connect your Apollo
# account; it stores the resulting token in the vault above automatically.
APOLLO_MCP_URL=https://mcp.apollo.io/mcp

# Only set these if apollo_oauth_connect.py's auto-discovery fails (it will
# tell you exactly which of these it needs). Leave blank otherwise.
APOLLO_OAUTH_AUTHORIZATION_ENDPOINT=
APOLLO_OAUTH_TOKEN_ENDPOINT=
APOLLO_OAUTH_REGISTRATION_ENDPOINT=
APOLLO_OAUTH_CLIENT_ID=
APOLLO_OAUTH_CLIENT_SECRET=

# Output
LEADS_OUTPUT_DIR=./output

# Email (SMTP via Gmail / Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Use a Gmail "App Password" (Google Account -> Security -> App Passwords), not your normal password
SMTP_PASSWORD=
SMTP_FROM=

# Recipient
SDR_EMAIL=

# HubSpot — create a Private App in HubSpot: Settings -> Integrations ->
# Private Apps -> Create. Scopes needed: crm.objects.contacts.read/write,
# crm.objects.companies.read/write, crm.objects.notes.write.
HUBSPOT_ACCESS_TOKEN=
